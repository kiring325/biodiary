**/.cache/

# Local databases, logs, and signing keys
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.log
**/*.jks
**/*.keystore

# Old duplicate release artifacts at the outputs root.
# Keep the current APK inside MoriNote-Web because the site links to it.
/Biodiary-*.apk
/MoriNote-Android.zip
